# 이 파일을 .env로 복사한 뒤 모든 예시 값을 실제 비밀값으로 교체한다.
DB_NAME=redcentra
DB_USERNAME=redcentra
DB_PASSWORD=change-me
REDIS_PASSWORD=change-me
RABBITMQ_USER=redcentra
RABBITMQ_PASSWORD=change-me
OPENSEARCH_ADMIN_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me
SEAWEEDFS_ACCESS_KEY=local-access-key
SEAWEEDFS_SECRET_KEY=local-secret-key
API_VERSION=0.1.0
CORS_ALLOWED_ORIGINS=https://redcentra.example.internal
JWT_SECRET=change-me-to-a-long-random-value

