{
  "id": null,
  "uid": "api-access-log-overview",
  "title": "API Access Log",
  "description": "ApiAccessLogFilter가 OpenSearch(api-access-log-*)에 남기는 요청 단위 접근 로그 개요",
  "tags": ["api-access-log", "openrack"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "editable": true,
  "graphTooltip": 1,
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total Requests",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-api-access-log" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-api-access-log" },
          "metrics": [{ "type": "count", "id": "1" }],
          "bucketAggs": [{ "type": "date_histogram", "field": "@timestamp", "id": "2", "settings": { "interval": "auto" } }],
          "timeField": "@timestamp",
          "query": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Errors (4xx/5xx)",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-api-access-log" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-api-access-log" },
          "metrics": [{ "type": "count", "id": "1" }],
          "bucketAggs": [{ "type": "date_histogram", "field": "@timestamp", "id": "2", "settings": { "interval": "auto" } }],
          "timeField": "@timestamp",
          "query": "httpStatus.keyword:/[45][0-9][0-9]/"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Success (2xx/3xx)",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-api-access-log" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-api-access-log" },
          "metrics": [{ "type": "count", "id": "1" }],
          "bucketAggs": [{ "type": "date_histogram", "field": "@timestamp", "id": "2", "settings": { "interval": "auto" } }],
          "timeField": "@timestamp",
          "query": "httpStatus.keyword:/[23][0-9][0-9]/"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Requests over time (by status)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-api-access-log" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-api-access-log" },
          "metrics": [{ "type": "count", "id": "1" }],
          "bucketAggs": [
            { "type": "terms", "field": "httpStatus.keyword", "id": "3", "settings": { "size": "5", "order": "desc", "orderBy": "_count" } },
            { "type": "date_histogram", "field": "@timestamp", "id": "2", "settings": { "interval": "auto" } }
          ],
          "timeField": "@timestamp",
          "query": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 40, "stacking": { "mode": "normal", "group": "A" }, "lineWidth": 1 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 5,
      "type": "barchart",
      "title": "Status Code Breakdown",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-api-access-log" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-api-access-log" },
          "metrics": [{ "type": "count", "id": "1" }],
          "bucketAggs": [{ "type": "terms", "field": "httpStatus.keyword", "id": "2", "settings": { "size": "10", "order": "desc", "orderBy": "_count" } }],
          "timeField": "@timestamp",
          "query": ""
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "Top Request URIs",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-api-access-log" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-api-access-log" },
          "metrics": [{ "type": "count", "id": "1" }],
          "bucketAggs": [{ "type": "terms", "field": "requestUri.keyword", "id": "2", "settings": { "size": "10", "order": "desc", "orderBy": "_count" } }],
          "timeField": "@timestamp",
          "query": ""
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Recent Access Log Entries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-api-access-log" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-api-access-log" },
          "metrics": [{ "type": "logs", "id": "1" }],
          "bucketAggs": [],
          "timeField": "@timestamp",
          "query": ""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ]
}
